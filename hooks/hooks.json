{
  "description": "Vantage Point Dashboard + Lane hooks",
  "modules": [
    "./vp-mod.ts"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v vp >/dev/null 2>&1 && vp wire hook-check || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lane-status.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [],
    "PostToolUse": []
  }
}
